{
  "name": "picoruby-cloudflare-worker-spike",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rake -f Rakefile build",
    "build:app": "rake -f Rakefile app",
    "clean": "rake -f Rakefile clean",
    "watch:app": "node scripts/watch-app.mjs",
    "dev": "node scripts/watch-app.mjs --with-wrangler",
    "check": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run --outdir .wrangler-dist",
    "test": "node test/runtime.mjs"
  },
  "devDependencies": {
    "wrangler": "4.125.0"
  }
}
