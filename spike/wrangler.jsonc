{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "picoruby-cloudflare-worker-spike",
	"main": "src/index.js",
	"compatibility_date": "2026-08-22",
	"kv_namespaces": [
		{
			"binding": "CACHE_KV",
			"id": "0f9573b8367a487c929ce1f71c617169"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "picoruby-worker-spike",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "OBJECTS",
				"class_name": "PicoRubyDurableObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PicoRubyDurableObject"]
		}
	]
}
