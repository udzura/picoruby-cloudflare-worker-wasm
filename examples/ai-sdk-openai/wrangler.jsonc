{
  "name": "picoruby-ai-sdk-openai-example",
  "main": "worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }],
  "vars": {
    "OPENAI_TEXT_MODEL": "set-your-text-model",
    "OPENAI_EMBEDDING_MODEL": "set-your-embedding-model"
  }
}
